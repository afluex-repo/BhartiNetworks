@model BhartiNetwork.Models.Home
@{
ViewBag.Title = "Commercial";
  Layout = "~/Views/Shared/_RealityLayout.cshtml";
}
 
 

<style>
.property-card {
  transition: 0.3s ease;
overflow:hidden;
}

.property-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 25px rgba(0,0,0,0.08);
}

/* Ribbon */
.ribbon {
  position: absolute;
  top: 15px;
  left: -35px;
  background: #1e3a8a;
  color: #fff;
  padding: 5px 40px;
  font-size: 12px;
  transform: rotate(-45deg);
  font-weight: 600;
}

/* Mobile image adjustment */
@@media (max-width: 576px) {
  .card-img-top {
    height: 200px !important;
  }
}
</style>
<div class="breadcrumb-wrapper section-padding bg-cover"
   style="background-image: url('/assets/img/breadcrumb/Passive.jpg');">
  <div class="container">
    <div class="page-heading">
      <h1 class="wow fadeInUp" data-wow-delay=".3s">Commercial</h1>
      <ul class="breadcrumb-items wow fadeInUp" data-wow-delay=".5s">
        <li>
          <a href="/Home/index">
            Home
          </a>
        </li>
        <li>
          <i class="fal fa-minus"></i>
        </li>
        <li>
          Commercial
        </li>
      </ul>
    </div>
  </div>
</div>
 


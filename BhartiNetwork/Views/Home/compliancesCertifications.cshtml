@model BhartiNetwork.Models.Home
@{
    ViewBag.Title = "compliancesCertifications";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

 <style> 
  img.no-save {
    -webkit-user-drag: none;
    user-select: none;
    pointer-events: none; 
  }
  * {
    -webkit-touch-callout: none; 
  }
</style>

@using (Html.BeginForm("compliancesCertifications", "Home", FormMethod.Post))
{
    <div class="breadcrumb-wrapper section-padding bg-cover"
         style="background-image: url('/assets/img/breadcrumb/CompliancesAndCertifications.jpg');">
        <div class="container">
            <div class="page-heading">
                <h1 class="wow fadeInUp" data-wow-delay=".3s">Compliances and Certifications</h1>
                <ul class="breadcrumb-items wow fadeInUp" data-wow-delay=".5s">
                    <li>
                        <a href="/Home/Index">
                            Home
                        </a>
                    </li>
                    <li>
                        <i class="fal fa-minus"></i>
                    </li>
                    <li>
                        Compliances and Certifications
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <section class="py-5">
        <div class="container aos-init aos-animate" data-aos="fade-up">
            <div class="row">
                <div class="col-md-12 col-lg-12 col-12">
                    <div class="section-title pb-0">
                        <h2 class="text-capitalize">
                            Compliances and <span style="color:#f6b024">Certifications</span>
                        </h2>
                    </div>
                </div>
                <div class="col-lg-12 col-md-12 mb-3">
                    <p>
                        We operationalize our Integrity culture through a variety of Compliance processes as described
                        below:
                    </p>
                    <ul class="list-unstyled">
                        <li>
                            <i class="far fa-check me-2 text-warning"></i>
                            <b>Provident Fund </b>– Fully complaint to the EPFO’s Rules &amp; Regulations.
                        </li>
                        <li>
                            <i class="far fa-check me-2 text-warning"></i>
                            <b>ESIC/Insurance</b> – Providing social security &amp; healthcare to all our employees.
                        </li>
                        <li>
                            <i class="far fa-check me-2 text-warning"></i>
                            <b>Workmen Compensation &amp; Medical</b> – Apart from ESIC, to safeguard all the employees
                            and their families against various risks.
                        </li>
                    </ul>
                </div>
            </div>




            <div class="row">
                <!-- Certificate Card Start -->
                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="certificateContent shadow">

                        <a href="/assets/img/certificate_1.JPEG" class="portfolio-lightbox">
                            <img src="/assets/img/certificate_1.JPEG" class="img-fluid" alt="">
                        </a>
                    </div>
                </div>

                <!-- Repeat for other images -->
                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="certificateContent shadow">
                        <a href="/assets/img/certificate_2.JPEG" class="portfolio-lightbox">
                            <img src="/assets/img/certificate_2.JPEG" class="img-fluid" alt="">
                        </a>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="certificateContent shadow">
                        <a href="/assets/img/certificate_3.JPEG" class="portfolio-lightbox">
                            <img src="/assets/img/certificate_3.JPEG" class="img-fluid" alt="">
                        </a>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="certificateContent shadow">
                        <a href="/assets/img/certificate_4.JPEG" class="portfolio-lightbox">
                            <img src="/assets/img/certificate_4.JPEG" class="img-fluid" alt="">
                        </a>
                    </div>
                </div>
            </div>


        </div>
    </section>
}
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js" integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script>
    $(document).ready(function() {
        $('.portfolio-lightbox').magnificPopup({
            type: 'image',
            gallery: {
                enabled: true
            },
            zoom: {
                enabled: true,
                duration: 300
            }
        });
    });


  // Disable right-click
  document.addEventListener('contextmenu', function (e) {
    e.preventDefault();
  });

  // Optional: Disable keyboard shortcuts (Ctrl+S, Ctrl+U)
  document.addEventListener('keydown', function(e) {
    if ((e.ctrlKey && e.key === 's') || (e.ctrlKey && e.key === 'u')) {
      e.preventDefault();
    }
  });

</script>
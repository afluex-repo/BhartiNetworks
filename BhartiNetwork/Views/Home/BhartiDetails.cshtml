@model BhartiNetwork.Models.Home
@{
ViewBag.Title = "BhartiDetails";
Layout = "~/Views/Shared/_RealityLayout.cshtml";
}
<style>
   .PopularOverlay {
   position: absolute;
   inset: 0;
   background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);
   }

#video-breadcrumb-section {
    position: relative;
    width: 100%;
    height: 500px;
    overflow: hidden;
}

/* Video */
#video-breadcrumb-section .bg-video {
    position: absolute;
    top: 50%;
    left: 50%;
    min-width: 100%;
    min-height: 100%;
    transform: translate(-50%, -50%);
    object-fit: cover;
    z-index: 0;
}

/* Dark Overlay */
#video-breadcrumb-section .video-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    z-index: 1;
}

/* Content Center */
#video-breadcrumb-section .content-wrapper {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

/* Responsive */
@@media (max-width: 768px) {
    #video-breadcrumb-section {
        height: 300px;
    }
}


      
</style>

<div id="video-breadcrumb-section">

   <!-- Background Video -->
   <video autoplay muted loop playsinline class="bg-video">
      <source src="../assets/img/videoplayback.mp4" type="video/mp4">
      Your browser does not support the video tag.
   </video>

   <!-- Overlay -->
   <div class="video-overlay"></div>

   <!-- Content -->
   <div class="content-wrapper text-center text-white visually-hidden">
      <h1 class="wow fadeInUp" data-wow-delay=".3s">Passive</h1>

      <ul class="breadcrumb-items list-inline wow fadeInUp" data-wow-delay=".5s">
         <li class="list-inline-item">
            <a href="/Home/index" class="text-white text-decoration-none">
               Home
            </a>
         </li>
         <li class="list-inline-item">
            <i class="fal fa-minus"></i>
         </li>
         <li class="list-inline-item">
            Passive
         </li>
      </ul>
   </div>

</div>



<section class="feature-icon-box-area">
   <div class="container">
      <div class="feature-icon-box-wrapper p-3 bg-transparent">
         <div class="row g-4">

            <!-- Apartments -->

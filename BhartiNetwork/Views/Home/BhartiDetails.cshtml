					   <i class="fa fa-sitemap" aria-hidden="true"></i>
					  </div>
                  <div class="content">
                     <h3>Plots</h3>
                     <p>
                        Residential and commercial plots for sale in Lucknow with small to large plot size and well connectivity from highways and roads.
                     </p>
                  </div>
               </div>
            </div>

            <!-- Lease -->
              <div class="col-xl-3 col-lg-3 col-md-6 wow fadeInUp" data-wow-delay=".7s">
               <div class="icon-box-items flex-column shadow p-3 h-100 bg-light">
                  <div class="icon border shadow">
                     <i class="fas fa-file-signature"></i>
                  </div>
                  <div class="content">
                     <h3>Lease</h3>
                     <p>
                        Residential and commercial leasing options in Lucknow with flexible agreements and strong road connectivity.
                     </p>
                  </div>
               </div>
            </div>

         </div>
      </div>
   </div>
</section>

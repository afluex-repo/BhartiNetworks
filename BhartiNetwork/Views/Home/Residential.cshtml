@model BhartiNetwork.Models.Home
@{
ViewBag.Title = "Residential";
  Layout = "~/Views/Shared/_RealityLayout.cshtml";
}
 
 

<style>
.property-card {
  transition: 0.3s ease;
overflow:hidden;
}

.property-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 25px rgba(0,0,0,0.08);
}

/* Ribbon */
.ribbon {
  position: absolute;
  top: 15px;
  left: -35px;
  background: #1e3a8a;
  color: #fff;
  padding: 5px 40px;
  font-size: 12px;
  transform: rotate(-45deg);
  font-weight: 600;
}

/* Mobile image adjustment */
@@media (max-width: 576px) {
  .card-img-top {
    height: 200px !important;
  }
}
</style>

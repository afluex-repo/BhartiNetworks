@model BhartiNetwork.Models.Home
@{
    ViewBag.Title = "newuser";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

    <div class="breadcrumb-wrapper section-padding bg-cover"
         style="background-image: url('/assets/img/breadcrumb/VendorRegistration.jpg');">
        <div class="container">
            <div class="page-heading">
                <h1 class="wow fadeInUp" data-wow-delay=".3s">Vendor</h1>
                <ul class="breadcrumb-items wow fadeInUp" data-wow-delay=".5s">
                    <li>
                        <a href="/Home/Index">
                            Home Page
                        </a>
                    </li>
                    <li>
                        <i class="fal fa-minus"></i>
                    </li>
                    <li>
                        Vendor
                    </li>
                </ul>
            </div>
        </div>
    </div>
@using (Html.BeginForm("newuser", "Home", FormMethod.Post, new { @id = "signupForm", enctype = "multipart/form-data" }))
{

    @*<section class="py-4 "></section>*@
    <section class="py-5">
        <div class="container" data-aos="fade-up">
            <div class="section-title text-center">
                <h2>Vendor Registration Form</h2>
                <p style="color:red;">
                    @TempData["Registration"]
                </p>
            </div>
            <div class="row mt-1 d-flex justify-content-center" data-aos="fade-right" data-aos-delay="100">
                <div class="col-lg-8 p-4" data-aos="fade-left" data-aos-delay="100"
                     style="border: 2px dotted #f58634; border-radius: 25px;">
                    <div class="row">
                        <div class="col-md-12 form-group">
                            <label>Circle<span style="color: red">*</span></label>
                            @Html.TextBoxFor(m => m.Circle, new { @class = "form-control", @placeholder = "Circle" })
                            @Html.HiddenFor(m => m.PK_InvoiceId)
                            @*<input class="form-control" id="Circle" name="Circle" placeholder="Circle" type="text"
                                   value="" />
                            <input id="PK_InvoiceId" name="PK_InvoiceId" type="hidden" value="" />*@
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6 form-group">
                            <label>Name of Organization<span style="color: red">*</span></label>
                            @Html.TextBoxFor(m => m.OrganizationName, new { @class = "form-control", @placeholder = "Name of Organization", @onkeypress = "return onlyAlphabets();" })


                            @*<input class="form-control" id="OrganizationName" name="OrganizationName"
                                   onkeypress="return onlyAlphabets();" placeholder="Name of Organization" type="text"
                                   value="" />*@
                        </div>
                        <div class="col-md-6 form-group mt-3 mt-md-0">
                            <label>Starting of Organization<span style="color: red">*</span></label>
                            @Html.TextBoxFor(m => m.StartingofOrganization, new { @class = "form-control", @placeholder = "Starting of Organization" })
                            @*<input class="form-control" id="StartingofOrganization" name="StartingofOrganization"
                                   placeholder="Starting of Organization" type="text" value="" />*@
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6 form-group">
                            <label>Mobile Number<span style="color: red">*</span></label>
                            @Html.TextBoxFor(m => m.Mobile, new { @class = "form-control", @placeholder = "Mobile Number", @onkeypress = "return isNumberKey(event)", @maxlength = "10" })
                            @*<input class="form-control" id="Mobile" maxlength="10" name="Mobile"
                                   onkeypress="return isNumberKey(event)" placeholder="Mobile Number" type="text"
                                   value="" />*@
                        </div>
                        <div class="col-md-6 form-group mt-3 mt-md-0">
                            <label>Email</label>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @placeholder = "Email", @onchange = "return ValidateEmail(event);" })
                            <span id="lblError" style="color:red"></span>
                            @*<input class="form-control" id="Email" name="Email" onchange="return ValidateEmail(event);"
                                   placeholder="Email" type="text" value="" />
                            <span id="lblError" style="color:red"></span>*@
                        </div>
                    </div>
                    <div class="form-group mt-3">
                        <label>Address & Co No<span style="color: red">*</span></label>
                        @Html.TextAreaFor(m => m.Address, new { @class = "form-control", @placeholder = "Address & Co No" })
                        @*<textarea class="form-control" cols="20" id="Address" name="Address"
                                  placeholder="Address &amp; Co No" rows="2"></textarea>*@
                    </div>
                    <hr class="mt-4 text-orange" />
                    <label class="fs-md-4 text-warning mb-2"><strong>BANK DETAILS</strong></label>
                    <div class="row">
                        <div class="col-md-12 form-group">
                            <label> Name As Per Bank Record<span style="color: red">*</span></label>
                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control", @placeholder = "Name As Per Bank Record" })
                            @*<input class="form-control" id="Name" name="Name" placeholder="Name As Per Bank Record"
                                   type="text" value="" />*@
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6 form-group">
                            <label>Account Number<span style="color: red">*</span></label>
                            @Html.TextBoxFor(m => m.AccountNo, new { @class = "form-control", @placeholder = "Account Number", @onkeypress = "return isNumberKey(event)" })
                            @*<input class="form-control" id="AccountNo" name="AccountNo"
                                   onkeypress="return isNumberKey(event)" placeholder="Account Number" type="text"
                                   value="" />*@
                        </div>
                        <div class="col-md-6 form-group mt-3 mt-md-0">
                            <label>Branch Address</label>
                            @Html.TextBoxFor(m => m.Branch, new { @class = "form-control", @placeholder = "Branch Address" })
                            @*<input class="form-control" id="Branch" name="Branch" placeholder="Branch Address"
                                   type="text" value="" />*@
                        </div>
                    </div>
                    <hr class="mt-4 text-orange" />
                    <label class="fs-md-4 text-warning mb-2"><strong>MODE OF PAYMENT</strong></label>
                    <div class="row">
                        <div class="col-md-12 form-group">
                            <label>Deposit in the Bank<span style="color: red">*</span></label>
                            @Html.TextBoxFor(m => m.Deposit, new { @class = "form-control", @placeholder = "Deposit in the Bank" })
                            @*<input class="form-control" id="Deposit" name="Deposit" placeholder="Deposit in the Bank"
                                   type="text" value="" />*@
                        </div>
                    </div>
                    <hr class="mt-4 text-orange" />
                    <div class="row mt-3">
                        <div class="col-md-12 form-group">
                            <!-- <input type="text" name="position" class="form-control" id="position" placeholder="Select Your Position" required> -->
                            <label>Type of Organization</label>
                            @Html.DropDownListFor(m => m.PK_OrganisationTypeId, new SelectList(ViewBag.ddlOrganizationType, "Value", "Text"), new { @class = "form-control" })
                            @*<select class="form-control" id="PK_OrganisationTypeId" name="PK_OrganisationTypeId">
                                <option value="0">--Select--</option>
                                <option value="1">Partnership</option>
                                <option value="2">Propreitory</option>
                                <option value="3">Public Ltd</option>
                                <option value="4">Pvt Ltd</option>
                            </select>*@
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6 form-group mb-3">
                            <label>Pan Number.</label>
                            @Html.TextBoxFor(m => m.PanNo, new { @class = "form-control", @placeholder = "Pan Number." })
                            @*<input class="form-control" id="PanNo" name="PanNo" placeholder="Pan Number." type="text"
                                   value="" />*@
                        </div>
                        <div class="col-md-6 form-group mb-3">
                            <label>GST Number.</label>
                            @Html.TextBoxFor(m => m.GSTNo, new { @class = "form-control", @placeholder = "GST Number." })
                            @*<input class="form-control" id="GSTNo" name="GSTNo" placeholder="GST Number." type="text"
                                   value="" />*@
                        </div>
                        <div class="col-md-6 form-group mb-3">
                            <!-- <input type="text" name="position" class="form-control" id="position" placeholder="Select Your Position" required> -->
                            <label>Designation</label>
                            @Html.DropDownListFor(m => m.PK_DesignationId, new SelectList(ViewBag.ddlDesignation, "Value", "Text"), new { @class = "form-control" })
                            @*<select class="form-control" id="PK_DesignationId" name="PK_DesignationId">
                                <option value="0">--Select--</option>
                                <option value="1">
                                    BTS,Node-B,MR,LTE,Installation &amp; Commissioning,CAB-EX &amp; All
                                    the Extra Activity
                                </option>
                                <option value="2">Link Installation And Commissioning</option>
                                <option value="3">Site Survey</option>
                                <option value="4">Man Power Supply</option>
                                <option value="5">Civil Work</option>
                                <option value="6">Electrical Work</option>
                            </select>*@
                        </div>
                        <div class="col-md-6 form-group mb-3">
                            <label>Vendor File</label>
                            <input type="file" class="form-control" style="line-height: 2.2;" accept="image/*" name="postedFile" id="postedFile" placeholder="Submit Your Cover Letter or Resume">
                        </div>
                        <div class="col-md-12">
                            <div class="text-center">
                                <button type="submit" class="theme-btn" onclick="return validateform();">Submit Form</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>




  <!-------==========Whatsapp==================---------->
    <a href="https://api.whatsapp.com/send?phone=919839418222" class="float" target="_blank">
        <i class="bi bi-whatsapp my-float"></i>
    </a>
    <!-------==========Whatsapp==================---------->
}




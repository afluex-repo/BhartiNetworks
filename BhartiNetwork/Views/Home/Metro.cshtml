                    </div>
                </div>
                <div class="col-sm-6 col-lg-4 col-md-6 mb-3">
                    <div class="card">
                        <img src="/assets/img/metro-3.jpeg" class="img-fluid shadow border rounded p-2" style="height: 200px;">
                    </div>
                </div>
                <div class="col-sm-6 col-lg-4 col-md-6 mb-3">

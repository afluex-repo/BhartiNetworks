                                        <a href="tel:+0522 4646187">0522 4646187 </a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6 wow fadeInUp" data-wow-delay=".7s">
                                <div class="info-items">
                                    <div class="icon">
                                        <i class="fal fa-envelope"></i>
                                    </div>
                                    <div class="content">
                                        <h5>Email</h5>
                                        <a href="mailto:info@bhartinetworks.com"
                                           class="link">info@bhartinetworks.com</a>
                                    </div>
                                </div>
